diff --git a/lua54.lua b/lua54.lua
new file mode 100644
index 0000000..ad56b18
--- /dev/null
+++ b/lua54.lua
@@ -0,0 +1,13 @@
+-- Lua 5.4 port shim for Legend of Lua.
+--
+-- The game targets LÖVE 11.5, which ships LuaJIT — i.e. Lua 5.1. love.wasm runs
+-- PUC Lua 5.4, because LuaJIT has no wasm backend. Three standard-library names
+-- moved between those versions, across 41 call sites in this game and the
+-- libraries it vendors (hump, windfield, sti, mlib). Restoring the names once is
+-- what a port does; forking four third-party libraries is not.
+--
+-- Every line is a no-op under 5.1, so the game still runs on desktop LÖVE
+-- unchanged: the `or` keeps whatever is already there.
+unpack = unpack or table.unpack
+table.getn = table.getn or function(t) return #t end
+math.atan2 = math.atan2 or function(y, x) return math.atan(y, x) end
